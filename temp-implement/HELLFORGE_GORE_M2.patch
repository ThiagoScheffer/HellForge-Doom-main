diff --git a/duct-tape-doom-main/platform/scene3d/gore_policy.h b/duct-tape-doom-main/platform/scene3d/gore_policy.h
new file mode 100644
index 0000000..e9420c4
--- /dev/null
+++ b/duct-tape-doom-main/platform/scene3d/gore_policy.h
@@ -0,0 +1,81 @@
+#ifndef DOOM_SCENE3D_GORE_POLICY_H
+#define DOOM_SCENE3D_GORE_POLICY_H
+
+#include <array>
+#include <cstdint>
+
+extern "C" {
+#include "info.h"
+}
+
+namespace doom3d {
+
+enum class GoreRegion : uint8_t {
+    Unknown, Head, Chest, Belly, LeftArm, RightArm, LeftLeg, RightLeg, Count
+};
+enum class GoreOutcome : uint8_t {
+    None, HeavyImpact, HeadBurst, ChestCavity, BellyCavity, ArmSever, LegSever,
+    SkullBurst, RibBreak, PinkyViscera, CacoViscera
+};
+
+struct GoreProfile { int type; float range; };
+inline constexpr float goreRange=128.f, goreSeverRange=96.f;
+inline constexpr GoreProfile goreProfiles[]={
+    {MT_POSSESSED,goreRange}, {MT_SHOTGUY,goreRange}, {MT_TROOP,goreRange},
+    {MT_UNDEAD,goreRange}, {MT_FATSO,goreRange}, {MT_SERGEANT,goreRange},
+    {MT_HEAD,goreSeverRange}
+};
+inline const GoreProfile *goreProfile(int type) {
+    for(const auto &profile:goreProfiles)if(profile.type==type)return &profile;
+    return nullptr;
+}
+inline bool goreHuman(int type) {return type==MT_POSSESSED||type==MT_SHOTGUY;}
+
+struct GoreDecision {
+    int type=-1, contacts=0, spriteContacts=0, effectiveDamage=0, legacyHeads=0;
+    std::array<int,static_cast<unsigned>(GoreRegion::Count)> hits{};
+    float distance=0;
+    bool lethal=false, extreme=false, headEnabled=false, bodyEnabled=false, limbsEnabled=false;
+    int count(GoreRegion region) const {return hits[static_cast<unsigned>(region)];}
+};
+inline bool goreDominates(int count,int contacts,int minimum,int percent) {
+    return count>=minimum&&contacts>0&&count*100>=contacts*percent;
+}
+inline GoreOutcome goreCandidate(const GoreDecision &d) {
+    const auto *profile=goreProfile(d.type);
+    if(!profile||!d.lethal||!d.spriteContacts||d.distance>profile->range)return GoreOutcome::None;
+    const int head=d.count(GoreRegion::Head),chest=d.count(GoreRegion::Chest),belly=d.count(GoreRegion::Belly);
+    if(d.type==MT_SERGEANT)
+        return d.bodyEnabled&&d.effectiveDamage>=50&&d.spriteContacts>=3&&
+               goreDominates(chest+belly,d.spriteContacts,2,40)?GoreOutcome::PinkyViscera:GoreOutcome::None;
+    if(d.type==MT_HEAD)
+        return d.bodyEnabled&&d.effectiveDamage>=70&&d.spriteContacts>=4?GoreOutcome::CacoViscera:GoreOutcome::None;
+    if(d.extreme)return GoreOutcome::None;
+    const bool headDominant=goreHuman(d.type)?goreDominates(d.legacyHeads,d.contacts,1,50):
+                                              goreDominates(head,d.spriteContacts,1,50);
+    const bool chestDominant=goreDominates(chest,d.spriteContacts,2,40);
+    const bool bellyDominant=goreDominates(belly,d.spriteContacts,2,40);
+    if(d.type==MT_UNDEAD) {
+        if(d.headEnabled&&headDominant)return GoreOutcome::SkullBurst;
+        if(d.bodyEnabled&&(chestDominant||bellyDominant))return GoreOutcome::RibBreak;
+        return GoreOutcome::None;
+    }
+    if(d.type==MT_FATSO) {
+        if(d.bodyEnabled&&d.effectiveDamage>=60&&(chest>=3||belly>=3))
+            return chest>=belly?GoreOutcome::ChestCavity:GoreOutcome::BellyCavity;
+        return GoreOutcome::None;
+    }
+    if(d.headEnabled&&headDominant)return GoreOutcome::HeadBurst;
+    if(d.limbsEnabled&&d.distance<=goreSeverRange) {
+        for(auto leg:{GoreRegion::LeftLeg,GoreRegion::RightLeg})
+            if(goreDominates(d.count(leg),d.spriteContacts,2,40))return GoreOutcome::LegSever;
+        for(auto arm:{GoreRegion::LeftArm,GoreRegion::RightArm})
+            if(goreDominates(d.count(arm),d.spriteContacts,2,40))return GoreOutcome::ArmSever;
+    }
+    if(d.bodyEnabled&&chestDominant)return GoreOutcome::ChestCavity;
+    if(d.bodyEnabled&&bellyDominant)return GoreOutcome::BellyCavity;
+    return GoreOutcome::None;
+}
+
+}
+#endif
