#include <windows.h>
#include "build_version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION DOOM_ENGINE_VERSION_COMMA
 PRODUCTVERSION DOOM_ENGINE_VERSION_COMMA
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", DOOM_PRODUCT_ENGINE_NAME "\0"
   VALUE "FileVersion", DOOM_ENGINE_VERSION "\0"
   VALUE "ProductName", DOOM_PRODUCT_NAME "\0"
   VALUE "ProductVersion", DOOM_ENGINE_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
